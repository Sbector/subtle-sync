---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.jsx';
import site from '../data/site.json';

// Calculate cost totals
const totalPerModule = site.cost.items.reduce((sum, item) => {
	return sum + (item.cost ?? 0);
}, 0);

const totalForAllModules = totalPerModule * site.cost.modules;
const hasPending = site.cost.items.some(item => item.cost === null);
---

<Layout title="Subtle Sync">
	<Scene client:load />
	<div class="overlay">
		<!-- Sección 1: Introducción -->
		<section class="section fade-item visible">
			<div class="content">
				<h1 class="title">{site.intro.title}</h1>
				<p class="paragraph">
					{site.intro.paragraph}
				</p>
			</div>
		</section>

		<!-- Sección 2: Descripción -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">{site.description.heading}</h2>
				<p class="paragraph">
					{site.description.paragraph}
				</p>
			<video src={site.description.video} class="content-image" autoplay loop muted playsinline></video>
			</div>
		</section>

		<!-- Sección 3: Justificación -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">{site.justification.heading}</h2>
				{site.justification.paragraphs.map((paragraph) => (
					<p class="paragraph">
						{paragraph}
					</p>
				))}
			</div>
		</section>

		<!-- Sección 4: Costo Estimado -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">{site.cost.heading} <span class="heading-note">{site.cost.headingNote}</span></h2>
				<div class="cost-table-wrapper">
					<table class="cost-table">
						<thead>
							<tr>
								<th>Ítem</th>
								<th>Descripción</th>
								<th>Costo estimado</th>
							</tr>
						</thead>
						<tbody>
							{site.cost.items.map((item) => (
								<tr class={item.cost === null ? 'cost-row-pending' : ''}>
									<td>{item.item}</td>
									<td>{item.description}</td>
									<td>{item.cost === null ? '—' : `$${item.cost} MXN`}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<div class="cost-total">
					<p><strong>Total estimado por módulo: ${totalPerModule} MXN</strong> {hasPending && <span class="cost-note">+ componentes pendientes</span>}</p>
					{site.cost.modules > 1 && (
						<p><strong>Total para {site.cost.modules} módulos: ${totalForAllModules} MXN</strong></p>
					)}
				</div>
			</div>
		</section>

		<!-- Sección 5: Transición en Blanco -->
		<section class="section section-blank">
			<div id="explore-trigger" style="position: absolute; bottom: 0; width: 100%; height: 1px;"></div>
		</section>

	</div>

	<style>
		.overlay {
			pointer-events: none;
			position: relative;
			z-index: 10;
			background: transparent;
		}

		.section {
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: flex-start;
			padding: 2rem;
		}

		.section-blank {
			min-height: 100vh;
			background: transparent;
			position: relative;
		}

		.content {
			pointer-events: auto;
			width: 45%;
			padding-left: 4rem;
			touch-action: pan-y;
			user-select: none;
		}

		.title {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 4rem;
			font-weight: 700;
			color: #ffffff;
			margin: 0 0 1rem 0;
			text-shadow: 0 2px 20px rgba(0, 229, 255, 0.3);
			letter-spacing: -1px;
		}

		.subtitle {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.5rem;
			font-weight: 500;
			color: #00e5ff;
			margin: 0 0 2rem 0;
			text-shadow: 0 2px 10px rgba(0, 229, 255, 0.2);
		}

		.heading {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 2.5rem;
			font-weight: 600;
			color: #ffffff;
			margin: 0 0 1.5rem 0;
			text-shadow: 0 2px 15px rgba(255, 255, 255, 0.1);
		}

		.paragraph {
			font-family: 'Inter', sans-serif;
			font-size: 1.1rem;
			color: #e0e0e0;
			line-height: 1.8;
			margin: 1rem 0;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.image-placeholder {
			margin: 2rem 0;
			padding: 4rem 2rem;
			border: 2px dashed #00e5ff;
			border-radius: 8px;
			background: rgba(0, 229, 255, 0.05);
			text-align: center;
			color: #00e5ff;
			font-size: 1rem;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-table {
			width: 100%;
			border-collapse: collapse;
			margin: 2rem 0;
			font-family: 'Inter', sans-serif;
		}

		.cost-table-wrapper {
			width: 100%;
			overflow-x: auto;
			margin: 2rem 0;
			border-radius: 8px;
		}

		.cost-table thead {
			border-bottom: 2px solid #00e5ff;
		}

		.cost-table th {
			padding: 1rem;
			text-align: left;
			color: #00e5ff;
			font-weight: 600;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-table td {
			padding: 1rem;
			color: #e0e0e0;
			border-bottom: 1px solid rgba(0, 229, 255, 0.2);
			text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
		}

		.cost-total {
			text-align: right;
			font-size: 1.3rem;
			color: #00e5ff;
			margin-top: 2rem;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-total p {
			margin: 0.5rem 0;
		}

		.cost-note {
			font-size: 0.95rem;
			color: rgba(255, 255, 255, 0.5);
			font-weight: 400;
		}

		.heading-note {
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.45);
			font-weight: 400;
		}

		.cost-row-pending td {
			color: rgba(224, 224, 224, 0.4);
		}

		.content-image {
			width: 100%;
			border-radius: 8px;
			margin: 2rem 0;
			object-fit: cover;
			box-shadow: 0 4px 16px rgba(0, 229, 255, 0.1);
		}

		/* Fade-in animation */
		.fade-item {
			opacity: 0;
			transform: translateY(24px);
			transition: all 0.6s ease-out;
		}

		.fade-item.visible {
			opacity: 1;
			transform: translateY(0);
		}

		@media (max-width: 768px) {
			.content {
				width: 100%;
				padding-left: 1.5rem;
				padding-right: 1.5rem;
			}

			.title {
				font-size: 2.5rem;
			}

			.subtitle {
				font-size: 1.1rem;
			}

			.heading {
				font-size: 1.8rem;
			}

			.paragraph {
				font-size: 1rem;
			}

			.section {
				padding: 1.5rem 1rem;
			}

			.image-placeholder {
				padding: 2.5rem 1rem;
			}

			.cost-table th,
			.cost-table td {
				padding: 0.6rem 0.5rem;
				font-size: 0.85rem;
			}

			.cost-total {
				font-size: 1rem;
			}
		}
	</style>

	<script>
		const observerOptions = {
			threshold: 0.2,
			rootMargin: '0px 0px -50px 0px'
		}

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible')
					observer.unobserve(entry.target)
				}
			})
		}, observerOptions)

		document.querySelectorAll('.fade-item').forEach((el) => {
			observer.observe(el)
		})
	</script>
</Layout>
