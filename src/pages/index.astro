---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.jsx';
---

<Layout title="Subtle Sync">
	<Scene client:load />
	<div class="overlay">
		<!-- Sección 1: Introducción -->
		<section class="section fade-item visible">
			<div class="content">
				<h1 class="title">Subtle Sync</h1>
				<p class="paragraph">
					Subtle Sync es una instalación audiovisual inspirada en los momentos de sincronización espontánea que aparecen al observar luces de obstrucción en la distancia.
				</p>
			</div>
		</section>

		<!-- Sección 2: Descripción -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">Descripción</h2>
				<p class="paragraph">
					Subtle Sync funciona como una especie de ready-made perceptual basado en la observación de luces de obstrucción aérea en cerros y estructuras elevadas. La instalación reúne múltiples módulos de luz y sonido que operan con ritmos ligeramente distintos; con el tiempo, aparecen momentos efímeros de sincronización total antes de volver al desfase. La pieza busca trasladar ese fenómeno perceptual cotidiano a una experiencia espacial y sonora donde la sincronía emerge como un evento temporal e inestable.
				</p>
			<video src="/images/cerro.mp4" class="content-image" autoplay loop muted playsinline></video>
			</div>
		</section>

		<!-- Sección 3: Justificación -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">Justificación</h2>
				<p class="paragraph">
					La sincronía y la simultaneidad son condiciones fundamentales de la vida contemporánea. Sistemas tecnológicos, redes digitales y dinámicas sociales operan cada vez más mediante procesos de coordinación temporal compartida.
				</p>
				<p class="paragraph">
					Subtle Sync explora la tensión entre autonomía y alineación a través de módulos independientes que ocasionalmente convergen en estados de orden temporal. La obra plantea la sincronía no como una condición permanente, sino como un acuerdo momentáneo entre sistemas separados.
				</p>
			</div>
		</section>

		<!-- Sección 4: Costo Estimado -->
		<section class="section fade-item">
			<div class="content">
				<h2 class="heading">Costo estimado <span class="heading-note">(por módulo / luz)</span></h2>
				<table class="cost-table">
					<thead>
						<tr>
							<th>Ítem</th>
							<th>Descripción</th>
							<th>Costo estimado</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>ESP32</td>
							<td>Microcontrolador principal</td>
							<td>$179 MXN</td>
						</tr>
						<tr>
							<td>MAX98357A</td>
							<td>Amplificador de audio digital</td>
							<td>$100 MXN</td>
						</tr>
						<tr>
							<td>Bocina 4&quot; 4Ω</td>
							<td>Audio</td>
							<td>$60 MXN</td>
						</tr>
						<tr class="cost-row-pending">
							<td>Sistema de iluminación</td>
							<td>LED o fuente lumínica</td>
							<td>—</td>
						</tr>
						<tr class="cost-row-pending">
							<td>Controlador de luz</td>
							<td>MOSFET o circuito de potencia</td>
							<td>—</td>
						</tr>
						<tr class="cost-row-pending">
							<td>Fuente de alimentación</td>
							<td>Regulación y energía</td>
							<td>—</td>
						</tr>
						<tr class="cost-row-pending">
							<td>Cableado</td>
							<td>Conexiones y distribución</td>
							<td>—</td>
						</tr>
						<tr class="cost-row-pending">
							<td>Caja de resonancia</td>
							<td>Estructura acústica para bocina</td>
							<td>—</td>
						</tr>
					</tbody>
				</table>
				<p class="cost-total"><strong>Total estimado por módulo: $339 MXN</strong> <span class="cost-note">+ componentes pendientes</span></p>
			</div>
		</section>

		<!-- Sección 5: Transición en Blanco -->
		<section class="section section-blank">
			<div id="explore-trigger" style="position: absolute; bottom: 0; width: 100%; height: 1px;"></div>
		</section>

	</div>

	<style>
		.overlay {
			pointer-events: none;
			position: relative;
			z-index: 10;
			background: transparent;
		}

		.section {
			min-height: 100vh;
			display: flex;
			align-items: center;
			justify-content: flex-start;
			padding: 2rem;
		}

		.section-blank {
			min-height: 100vh;
			background: transparent;
			position: relative;
		}

		.content {
			pointer-events: auto;
			width: 45%;
			padding-left: 4rem;
		}

		.title {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 4rem;
			font-weight: 700;
			color: #ffffff;
			margin: 0 0 1rem 0;
			text-shadow: 0 2px 20px rgba(0, 229, 255, 0.3);
			letter-spacing: -1px;
		}

		.subtitle {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.5rem;
			font-weight: 500;
			color: #00e5ff;
			margin: 0 0 2rem 0;
			text-shadow: 0 2px 10px rgba(0, 229, 255, 0.2);
		}

		.heading {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 2.5rem;
			font-weight: 600;
			color: #ffffff;
			margin: 0 0 1.5rem 0;
			text-shadow: 0 2px 15px rgba(255, 255, 255, 0.1);
		}

		.paragraph {
			font-family: 'Inter', sans-serif;
			font-size: 1.1rem;
			color: #e0e0e0;
			line-height: 1.8;
			margin: 1rem 0;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.image-placeholder {
			margin: 2rem 0;
			padding: 4rem 2rem;
			border: 2px dashed #00e5ff;
			border-radius: 8px;
			background: rgba(0, 229, 255, 0.05);
			text-align: center;
			color: #00e5ff;
			font-size: 1rem;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-table {
			width: 100%;
			border-collapse: collapse;
			margin: 2rem 0;
			font-family: 'Inter', sans-serif;
		}

		.cost-table thead {
			border-bottom: 2px solid #00e5ff;
		}

		.cost-table th {
			padding: 1rem;
			text-align: left;
			color: #00e5ff;
			font-weight: 600;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-table td {
			padding: 1rem;
			color: #e0e0e0;
			border-bottom: 1px solid rgba(0, 229, 255, 0.2);
			text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
		}

		.cost-total {
			text-align: right;
			font-size: 1.3rem;
			color: #00e5ff;
			margin-top: 2rem;
			text-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
		}

		.cost-note {
			font-size: 0.95rem;
			color: rgba(255, 255, 255, 0.5);
			font-weight: 400;
		}

		.heading-note {
			font-size: 1rem;
			color: rgba(255, 255, 255, 0.45);
			font-weight: 400;
		}

		.cost-row-pending td {
			color: rgba(224, 224, 224, 0.4);
		}

		.content-image {
			width: 100%;
			border-radius: 8px;
			margin: 2rem 0;
			object-fit: cover;
			box-shadow: 0 4px 16px rgba(0, 229, 255, 0.1);
		}

		/* Fade-in animation */
		.fade-item {
			opacity: 0;
			transform: translateY(24px);
			transition: all 0.6s ease-out;
		}

		.fade-item.visible {
			opacity: 1;
			transform: translateY(0);
		}

		@media (max-width: 768px) {
			.content {
				width: 100%;
				padding-left: 1.5rem;
				padding-right: 1.5rem;
			}

			.title {
				font-size: 2.5rem;
			}

			.subtitle {
				font-size: 1.1rem;
			}

			.heading {
				font-size: 1.8rem;
			}

			.paragraph {
				font-size: 1rem;
			}

			.section {
				padding: 1.5rem 1rem;
			}

			.image-placeholder {
				padding: 2.5rem 1rem;
			}

			.cost-table th,
			.cost-table td {
				padding: 0.6rem 0.5rem;
				font-size: 0.85rem;
			}

			.cost-total {
				font-size: 1rem;
			}
		}
	</style>

	<script>
		const observerOptions = {
			threshold: 0.2,
			rootMargin: '0px 0px -50px 0px'
		}

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.classList.add('visible')
					observer.unobserve(entry.target)
				}
			})
		}, observerOptions)

		document.querySelectorAll('.fade-item').forEach((el) => {
			observer.observe(el)
		})
	</script>
</Layout>
